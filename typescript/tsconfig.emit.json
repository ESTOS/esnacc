{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noEmit": false,
		"sourceMap": true,
		"inlineSources": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"types": ["node"],
		"rootDir": ".",
		"outDir": "dist",
		"incremental": true,
		"tsBuildInfoFile": "dist/.tsbuildinfo"
	},
	"include": ["./**/*.ts"],
	"exclude": ["./node_modules/**", "./dist/**"]
}
