{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noEmit": true,
		"sourceMap": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"types": ["node"]
	},
	"include": ["./**/*.ts"],
	"exclude": ["./stub/**", "./node_modules/**"]
}
