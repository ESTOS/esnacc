{
	"extends": "https://raw.githubusercontent.com/ESTOS/eslint-config-estos/refs/heads/main/dprint.json",
	"typescript": {
		"arrayExpression.preferSingleLine": false,
		"arrayExpression.preferHanging": "always",
		"arrayPattern.preferSingleLine": false,
		"arrayPattern.preferHanging": true,
		"nextControlFlowPosition": "sameLine",
		"useBraces": "always"
	},
	"excludes": [
		"**/node_modules",
		"**/*-lock.json",
		"**/dist/**",
		"**/build/**",
		"**/output/**",
		"**/stub/**",
		"**/src/stub/**",
		"cpp-lib/jsoncpp/**"
	],
	"plugins": [
		"https://plugins.dprint.dev/typescript-0.93.4.wasm",
		"https://plugins.dprint.dev/json-0.19.4.wasm",
		"https://plugins.dprint.dev/markdown-0.17.8.wasm",
		"https://plugins.dprint.dev/toml-0.6.4.wasm",
		"https://plugins.dprint.dev/dockerfile-0.3.2.wasm",
		"https://plugins.dprint.dev/g-plane/malva-v0.11.1.wasm",
		"https://plugins.dprint.dev/g-plane/markup_fmt-v0.18.0.wasm",
		"https://plugins.dprint.dev/g-plane/pretty_yaml-v0.5.0.wasm"
	]
}
